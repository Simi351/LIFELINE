{
  "rules": {
    "mission": {
      "publicConfig": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'GAMEMASTER_EMAIL_HIER_EINTRAGEN'"
      },
      "privateConfig": {
        ".read": "auth != null && auth.token.email === 'GAMEMASTER_EMAIL_HIER_EINTRAGEN'",
        ".write": "auth != null && auth.token.email === 'GAMEMASTER_EMAIL_HIER_EINTRAGEN'"
      },
      "teams": {
        ".read": "auth != null",
        "$team": {
          ".write": "auth != null"
        }
      }
    }
  }
}